# ---- Base image (GPU + CPU fallback) ----
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    build-essential cmake git wget curl unzip \
    libglib2.0-0 libsm6 libxext6 libgl1-mesa-glx libgtk-3-0 \
    ffmpeg openssl ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/project

RUN python3 -m pip install --upgrade pip setuptools wheel

COPY requirements.prod /opt/project/

RUN python3 -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 || \
    python3 -m pip install torch torchvision torchaudio

RUN python3 -m pip install cupy-cuda12x==13.6.0 || true

RUN python3 -m pip install vllm==0.10.1.1 || python3 -m pip install vllm

RUN python3 -m pip install --no-cache-dir -r requirements.prod

COPY . /opt/project
RUN chmod +x /opt/project/entrypoint.sh

ENV VLLM_LOGGING_LEVEL=INFO
ENTRYPOINT ["/bin/bash", "/opt/project/entrypoint.sh"]
