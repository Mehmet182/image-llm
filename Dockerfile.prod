# Dockerfile (gpu-friendly, cpu fallback)
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libglib2.0-0 libsm6 libxext6 libgl1-mesa-glx \
    python3 python3-pip python3-dev ffmpeg openssl git wget curl unzip gnupg \
    ca-certificates fonts-liberation libnss3 libatk-bridge2.0-0 libgtk-3-0 \
    libx11-xcb1 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 \
    libxrandr2 libxss1 libxtst6 xdg-utils ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64:$LD_LIBRARY_PATH
ENV PATH=/usr/local/cuda/bin:$PATH

WORKDIR /opt/project

COPY requirements.prod /opt/project/

RUN python3 -m pip install --upgrade pip setuptools
RUN python3 -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

RUN python3 -m pip install cupy-cuda12x==13.6.0 || true

RUN python3 -m pip install vllm==0.10.1.1 || python3 -m pip install vllm

RUN python3 -m pip install --no-cache-dir -r requirements.prod

COPY . /opt/project
RUN chmod +x /opt/project/entrypoint.sh

ENV VLLM_LOGGING_LEVEL=INFO

ENTRYPOINT ["/bin/bash", "/opt/project/entrypoint.sh"]
