FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx \
    python3.10 \
    python3-pip \
    python3-dev \
    ffmpeg \
    openssl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/project

COPY requeriments.prod /opt/project/

RUN pip install --no-cache-dir \
    torch==2.3.1 \
    torchvision==0.18.1 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir -r requirements.prod

COPY . /opt/project

RUN ["chmod", "+x", "/opt/project/entrypoint.sh"]

ENTRYPOINT ["/bin/bash", "/opt/project/entrypoint.sh"]
